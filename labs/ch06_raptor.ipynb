   "source": [
    "def notebook_raptor(data, origins, departure_secs, max_rounds=2):\n",
    "    \"\"\"노트북에서 작성한 RAPTOR: 라운드별 정류장 도착시각을 반환합니다.\"\"\"\n",
    "    # 차량 탑승 전에는 접근 도보로 도달한 정류장만 채웁니다.\n",
    "    prev = [INF] * data.n_stops\n",
    "    for stop, walk_seconds in origins:\n",
    "        prev[stop] = min(prev[stop], departure_secs + walk_seconds)\n",
    "    rounds = [prev]\n",
    "    marked = {s for s, t in enumerate(prev) if t < INF}\n",
    "\n",
    "    for _ in range(max_rounds):\n",
    "        # 이전 경로를 남기고, 이번 라운드에 개선된 곳을 따로 모읍니다.\n",
    "        cur = list(prev)\n",
    "        improved = set()\n",
    "        queue = {}\n",
    "        # 개선된 정류장을 지나는 패턴을 가장 앞 위치부터 조사합니다.\n",
    "        for stop in marked:\n",
    "            for pattern_idx, position in data.routes_by_stop[stop]:\n",
    "                queue[pattern_idx] = min(position, queue.get(pattern_idx, position))\n",
    "\n",
    "        for pattern_idx, start in queue.items():\n",
    "            pattern = data.patterns[pattern_idx]\n",
    "            trip = None\n",
    "            for position in range(start, len(pattern.stops)):\n",
    "                stop = pattern.stops[position]\n",
    "                # 앞에서 선택한 차량의 이 정류장 도착시각을 확인합니다.\n",
    "                if trip is not None:\n",
    "                    arrival = pattern.arrivals[trip][position]\n",
    "                    if arrival < cur[stop]:\n",
    "                        cur[stop] = arrival\n",
    "                        improved.add(stop)\n",
    "                # 새 승차는 반드시 이전 라운드의 도착시각에서 판단합니다.\n",
    "                if prev[stop] < INF:\n",
    "                    departures = [row[position] for row in pattern.departures]\n",
    "                    candidate = choose_trip(departures, prev[stop])\n",
    "                    if candidate is not None and (trip is None or\n",
    "                        departures[candidate] < departures[trip]):\n",
    "                        trip = candidate\n",
    "\n",
    "        # 이번에 더 일찍 도착한 정류장에서는 한 번 걸을 수 있습니다.\n",
    "        for stop in list(improved):\n",
    "            for other, walk_seconds in data.transfers[stop]:\n",
    "                arrival = cur[stop] + walk_seconds\n",
    "                if arrival < cur[other]:\n",
    "                    cur[other] = arrival\n",
    "                    improved.add(other)\n",
    "        rounds.append(cur)\n",
    "        if not improved:\n",
    "            break\n",
    "        prev, marked = cur, improved\n",
    "    return rounds\n",
    "\n",
    "rounds = notebook_raptor(data, [(a, 0)], 8 * 3600, max_rounds=3)\n",
    "display(pd.DataFrame([[clock(t) for t in row] for row in rounds],\n",
    "                     columns=data.stop_ids,\n",
    "                     index=[f\"라운드 {k}\" for k in range(len(rounds))]))"
   ]
  },
