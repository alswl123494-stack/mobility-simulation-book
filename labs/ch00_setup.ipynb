    ")\n",
    "\n",
    "sim = dt.run_simulation(**REFERENCE)   # ** 는 딕셔너리를 키워드 인자로 풀어 넣는 문법입니다\n",
    "print(\"sim 의 클래스:\", type(sim).__name__)\n",
    "sim.summary()"
   ]
