    "REFERENCE = dict(\n",
    "    city=\"hanam\",\n",
    "    mode=\"taxi\",\n",
    "    fleet_size=80,\n",
    "    num_passengers=1000,\n",
    "    time_start=1080,                  # 18:00\n",
    "    time_end=1440,                    # 24:00\n",
    "    dispatch_mode=\"optimization\",     # 배차 규칙. 여러 호출과 빈 차를 한꺼번에 짝지어 배정합니다 (10장)\n",
    "    matrix_mode=\"street_distance\",    # 차량과 승객 사이 거리를 직선이 아니라 도로망 경로로 잽니다 (3장)\n",
    "    vehicle_capacity=1,               # 차량 한 대에 승객 한 명. 합승이 없습니다\n",
