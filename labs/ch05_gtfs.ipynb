    "    direct = at_a.merge(at_c, on=\"trip_id\", validate=\"one_to_one\")\n",
    "    direct[\"dep_s\"] = direct[\"departure_time\"].map(parse_gtfs_time)\n",
    "    direct[\"arr_s\"] = direct[\"arrival_time\"].map(parse_gtfs_time)\n",
    "    display(direct)\n",
